# HouseFolio environment variables

# App
NEXT_PUBLIC_APP_NAME=HouseFolio
NEXT_PUBLIC_APP_STAGE=demo

# Database provider
# Demo stage: supabase
# Future mainland stage: cn-postgres
DATABASE_PROVIDER=not-configured

# Auth provider
AUTH_PROVIDER=not-configured

# AI provider
AI_PROVIDER=not-configured
AI_API_KEY=

# LBS provider
LBS_PROVIDER=not-configured
AMAP_API_KEY=

# Browser-only AMap JS API map picker
# Protect the Web (JS API) key with an AMap domain allowlist and securityJsCode.
NEXT_PUBLIC_AMAP_JS_API_KEY=
NEXT_PUBLIC_AMAP_JS_SECURITY_CONFIG=

# Storage provider
STORAGE_PROVIDER=local-first
